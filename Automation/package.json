{
  "name": "automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:known-bugs": "cypress run --expose runKnownBugTests=true",
    "cy:run:auth": "cypress run --spec cypress/e2e/authentication.cy.js",
    "cy:run:auth:known-bugs": "cypress run --spec cypress/e2e/authentication.cy.js --expose runKnownBugTests=true",
    "cy:run:accounts": "cypress run --spec cypress/e2e/accounts.cy.js",
    "cy:run:transfers": "cypress run --spec cypress/e2e/transfers.cy.js",
    "cy:run:transactions": "cypress run --spec cypress/e2e/transactions.cy.js",
    "cy:run:profile": "cypress run --spec cypress/e2e/customer-profile.cy.js"
  },
  "keywords": [
    "qa",
    "cypress",
    "ui-automation",
    "e2e-testing",
    "authentication",
    "parabank"
  ],
  "author": "",
  "license": "ISC",
  "description": "ParaBank Cypress UI automation suite",
  "devDependencies": {
    "cypress": "^15.14.2"
  }
}
